# Instructions
# 1. Copy this file to .env
# 2. Replace all placeholders with actual values
# 3. Ensure .env is not committed to version control 

# ========== MCP Server ==========
# WeKnora API Key — generate in WeKnora UI "Settings → API Keys", used by MCP Server to access REST API
# WEKNORA_API_KEY=
# MCP Server port exposed to the host (default 8082)
# MCP_PORT=8082

# ========== Image Version ==========
# WeKnora image version tag. Options: latest (stable), main (latest dev)
# WEKNORA_VERSION=latest

# gin mode
# Options: debug (dev mode, verbose logs), release (production, disables Swagger docs)
GIN_MODE=release

# Log level. Options: debug, info, warn, error, fatal. Default: debug
# LOG_LEVEL=debug

# LLM debug log: writes full request/response of each LLM call to a separate log file for troubleshooting.
# Options: true (auto-creates llm_debug.log next to LOG_PATH), false/empty (disabled), or a custom file path
# LLM_DEBUG_LOG=true

# ========== Built-in Models Declarative Configuration (optional) ==========
# If config/builtin_models.yaml is enabled (see config/builtin_models.yaml.example),
# ${NAME} placeholders in the YAML are resolved from this file at application startup.
# Variable names are defined by the YAML itself; the examples below are common starting points.
# See docs/BUILTIN_MODELS.md for details.
#
# LLM_MODEL_NAME=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=openai
#
# EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_PROVIDER=openai
#
# RERANK_MODEL_NAME=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_PROVIDER=generic

# ========== Langfuse Observability (optional) ==========
# Tracks chat / embedding / rerank / VLM / ASR model calls and token usage.
# Details: docs/Langfuse集成.md
#
# Option A: Langfuse Cloud (easiest)
#   1) Log in at https://cloud.langfuse.com and generate an API Key
#   2) Fill in PUBLIC_KEY / SECRET_KEY below
#   3) docker compose up -d app
#
# Option B: Self-hosted Langfuse (LAN/private network)
#   1) Start the self-hosted stack: docker compose --profile langfuse up -d
#      ClickHouse migration takes ~1-2 minutes on first start; wait for langfuse-web to become healthy
#   2) Open http://localhost:3000, register an admin account, and generate an API Key
#   3) Uncomment LANGFUSE_HOST=http://langfuse-web:3000 below
#      and fill in the PUBLIC_KEY / SECRET_KEY you just generated
#   4) docker compose up -d app
#
# Enabled automatically when both PUBLIC_KEY + SECRET_KEY are set — no explicit toggle needed.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=http://langfuse-web:3000
# In self-hosted mode, change to: LANGFUSE_HOST=http://langfuse-web:3000
#
# Optional: explicit toggle (true/false, auto-detected from keys by default)
# LANGFUSE_ENABLED=true
# Optional: version / environment labels for filtering in Langfuse UI
# LANGFUSE_RELEASE=v0.4.2
# LANGFUSE_ENVIRONMENT=production
# Optional: batch reporting and sampling (high-traffic: increase FLUSH_AT, decrease SAMPLE_RATE)
# LANGFUSE_FLUSH_AT=15
# LANGFUSE_FLUSH_INTERVAL=3s
# LANGFUSE_QUEUE_SIZE=2048
# LANGFUSE_REQUEST_TIMEOUT=10s
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_DEBUG=false

# ========== Langfuse Self-Hosted Stack (only needed with --profile langfuse) ==========
# Design note: to minimize resource usage, the self-hosted Langfuse stack **reuses** WeKnora's existing:
#   - postgres: creates a separate "langfuse" database (by the langfuse-db-init container, one-time)
#   - redis   : uses a separate Redis DB number (default 1, WeKnora uses 0)
# Only 3 new long-running containers are added: langfuse-web, langfuse-worker, langfuse-clickhouse
#                         + 1 dedicated S3: langfuse-minio
#                         + 1 one-time init: langfuse-db-init
#
# Langfuse Web UI host port
# LANGFUSE_WEB_PORT=3000
#
# Langfuse dedicated MinIO ports (to avoid conflict with WeKnora main MinIO 9000/9001)
# LANGFUSE_MINIO_S3_PORT=9100
# LANGFUSE_MINIO_CONSOLE_PORT=9101
#
# Langfuse database name within WeKnora-postgres
# LANGFUSE_DB_NAME=langfuse
#
# Redis DB number used by Langfuse (1~15, avoid conflict with WeKnora's 0)
# LANGFUSE_REDIS_DB=1
#
# ClickHouse / Langfuse MinIO credentials (change in production)
# LANGFUSE_CLICKHOUSE_USER=clickhouse
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_MINIO_USER=langfuseminio
# LANGFUSE_MINIO_PASSWORD=langfuseminiosecret
#
# Langfuse core security fields — regenerate for production:
#   LANGFUSE_SALT=$(openssl rand -base64 32)
#   LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)
#   LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -base64 32)
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# LANGFUSE_TELEMETRY_ENABLED=false
#
# Optional: automated first-time setup (injects admin + project, skips UI registration)
# LANGFUSE_INIT_ORG_NAME=WeKnora
# LANGFUSE_INIT_PROJECT_NAME=WeKnora
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-weknora-init
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-weknora-init
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=change-me-please

# Timezone setting, default Asia/Shanghai
# Affects system time display and log timestamps
# Common values: Asia/Shanghai, Asia/Tokyo, America/New_York, Europe/London, UTC
TZ=Asia/Shanghai

# Default system language (BCP-47 format), used as fallback for {{language}} placeholders in prompts
# Priority: Accept-Language header > this env var > built-in default (en-US)
# Common values: zh-CN, en-US, ja-JP, ko-KR, ru-RU
# WEKNORA_LANGUAGE=zh-CN

# Disable new user registration (recommended true in production)
DISABLE_REGISTRATION=false

# Ollama base URL for connecting to a local or remote Ollama service
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Storage config
# Primary database driver (postgres/mysql)
DB_DRIVER=postgres

# Vector store type (postgres/elasticsearch_v7/elasticsearch_v8/qdrant/milvus/weaviate/doris/tencent_vectordb)
RETRIEVE_DRIVER=postgres

# Allowed file storage types (comma-separated; leave empty to allow all)
# STORAGE_ALLOW_LIST=local,minio,cos,tos,s3

# File storage type (local/minio/cos/tos/s3)
STORAGE_TYPE=local

# Stream processing backend (memory/redis)
STREAM_MANAGER_TYPE=redis

# App service hostname, default is "app" (Docker internal service name)
# For remote backend, set to a remote address like remote-app.example.com
APP_HOST=app

# App service host-mapped port, default 8080 (only affects host access, not inter-container communication)
APP_PORT=8080

# NGINX backend proxy target port, default 8080 (app container's internal listening port)
# Local deployment: keep default, no need to change with APP_PORT
# Remote deployment: set to the actual port of the remote App service
# APP_BACKEND_PORT=8080

# NGINX backend proxy protocol, default http
# For remote HTTPS backends, set to https
# APP_SCHEME=http

# External access URL (only affects image/file links in IM channels with local storage)
# Set to the WeKnora instance's URL reachable by the IM platform / client, e.g. https://weknora.example.com
#
# Scope:
#   - local storage: required, otherwise IM receives local://... paths that can't be rendered
#   - MinIO/COS/OSS/S3/TOS/OBS/KS3: not read; their URLs are generated by their respective SDKs,
#     with the host determined by the corresponding *_ENDPOINT, which must also be publicly reachable
#
# Private IPs (192.168.x / 10.x / 172.16-31.x) and localhost are NOT reachable by Feishu / WeCom / Slack
# etc. For local development, use ngrok / cloudflared / frp tunnels.
# APP_EXTERNAL_URL=

# Frontend service port, default 80
FRONTEND_PORT=80

# Document parser port, default 50051
DOCREADER_PORT=50051

# Database host
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database username
DB_USER=postgres

# Database password
DB_PASSWORD=postgres123!@#

# Database name
DB_NAME=WeKnora

# If using redis as stream processing backend, configure the following
# Redis username (optional, Redis 6.0+ ACL support)
# REDIS_USERNAME=

# Redis password (leave empty if no password is set)
REDIS_PASSWORD=redis123!@#

# Redis database index, default 0
REDIS_DB=0

# Redis key prefix for namespace isolation
REDIS_PREFIX=stream:

# Base directory for local file storage
LOCAL_STORAGE_BASE_DIR=/data/files

# Auto-recover dirty data
AUTO_RECOVER_DIRTY=true

TENANT_AES_KEY=weknorarag-api-key-secret-secret

# AES-256 key for encrypting sensitive fields (API Keys, etc.) at rest in the database (must be 32 bytes)
SYSTEM_AES_KEY=weknora-system-aes-key-32bytes!!

# SSRF allowlist (optional). Comma-separated; each entry can be: exact domain (api.internal), wildcard domain (*.example.com),
# IPv4 (203.0.113.5), IPv6 (2001:db8::1, without brackets) or CIDR (10.0.0.0/8, 2001:db8::/32).
# Listed entries bypass SSRF checks. Use with caution in production.
# SSRF_WHITELIST=internal.service,*.corp.example,172.16.0.0/12,2001:db8::1,fd00::/8

# ===== SearXNG (optional self-hosted web search) =====
# Enable: `docker compose --profile searxng up -d`.
# When SEARXNG_SECRET is not set, the hardcoded default from docker-compose is used (sufficient for local/loopback).
# If you change SEARXNG_BIND=0.0.0.0 and expose the instance to LAN/public, you MUST generate a secret with
# `openssl rand -hex 32` and set SEARXNG_SECRET explicitly, otherwise the default can be used by anyone
# to sign image-proxy URLs.
#
# Backend access (containerized): in the console, select Provider type "SearXNG",
# Instance URL = http://searxng:8080 ; docker compose already injects the `searxng` hostname
# into SSRF_WHITELIST_EXTRA — no additional config needed.
#
# Local dev (go run + docker compose -f docker-compose.dev.yml --profile searxng up):
# Backend runs on the host, use the published port; Instance URL = http://127.0.0.1:8888,
# and add 127.0.0.1 to SSRF_WHITELIST:
#   SSRF_WHITELIST=127.0.0.1
#
# Port listens on 127.0.0.1 by default to avoid exposing a limiter:false instance to the LAN.
# To open to the internal network, explicitly set SEARXNG_BIND=0.0.0.0 and harden accordingly.
# SEARXNG_PORT=8888
# SEARXNG_BIND=127.0.0.1
# SEARXNG_SECRET=
# SSRF_WHITELIST_EXTRA=searxng

# Enable knowledge graph construction and retrieval (requires LLM calls during construction, takes time)
ENABLE_GRAPH_RAG=false


# JWT_SECRET for frontend login token refresh
JWT_SECRET=weknora-jwt-secret

# MinIO port
# MINIO_PORT=9000

# MinIO console port
# MINIO_CONSOLE_PORT=9001

# Embedding concurrency pool size. Reduce if you encounter 429 errors.
CONCURRENCY_POOL_SIZE=5

# (Removed: IMAGE_MAX_CONCURRENT, OCR_BACKEND — moved to Go App module after lightweight refactoring)

# If using ElasticSearch as vector store, configure the following
# ElasticSearch address, e.g. http://localhost:9200
# ELASTICSEARCH_ADDR=your_elasticsearch_addr

# ElasticSearch username (if auth is enabled)
# ELASTICSEARCH_USERNAME=your_elasticsearch_username

# ElasticSearch password (if auth is enabled)
# ELASTICSEARCH_PASSWORD=your_elasticsearch_password

# ElasticSearch index name for storing vector data
# ELASTICSEARCH_INDEX=WeKnora

# If using Qdrant as vector store, configure the following
# Qdrant host address
# QDRANT_HOST=localhost

# Qdrant port
# QDRANT_PORT=6334

# Qdrant collection name for storing vector data
# QDRANT_COLLECTION=weknora_embeddings

# Qdrant API key (optional)
# QDRANT_API_KEY=your_qdrant_api_key

# Enable TLS encryption (optional, default false)
# QDRANT_USE_TLS=false

# If using Tencent VectorDB as vector store, configure the following
# Tencent VectorDB address
# TENCENT_VECTORDB_ADDR=http://your-instance.tencentvectordb.com

# Tencent VectorDB username
# TENCENT_VECTORDB_USERNAME=root

# Tencent VectorDB API Key
# TENCENT_VECTORDB_API_KEY=your_tencent_vectordb_api_key

# Tencent VectorDB database name (optional, default weknora)
# TENCENT_VECTORDB_DATABASE=weknora

# Tencent VectorDB collection name prefix (optional, default weknora_embeddings; actual collections append vector dimension suffix)
# TENCENT_VECTORDB_COLLECTION=weknora_embeddings

# If using MinIO as file storage, configure the following
# MinIO endpoint (host:port). Modify when connecting to an external MinIO.
#
# Important: For IM channels, MINIO_ENDPOINT must be a host reachable by the IM platform / client.
# MinIO SDK generates presigned URLs using this host directly. Feishu / WeCom / Slack etc.
# cannot resolve docker-compose internal service names like minio:9000, causing images not to display in IM.
# Recommended: configure a public domain (e.g. minio.example.com) with HTTPS.
# MINIO_ENDPOINT=minio:9000

# MinIO access key
# MINIO_ACCESS_KEY_ID=your_minio_access_key

# MinIO secret key
# MINIO_SECRET_ACCESS_KEY=your_minio_secret_key

# MinIO bucket name for file storage
# MINIO_BUCKET_NAME=your_minio_bucket_name

# If using Tencent Cloud COS as file storage, configure the following
# Tencent Cloud COS secret ID
# COS_SECRET_ID=your_cos_secret_id

# Tencent Cloud COS secret key
# COS_SECRET_KEY=your_cos_secret_key

# Tencent Cloud COS region, e.g. ap-guangzhou
# COS_REGION=your_cos_region

# Tencent Cloud COS bucket name
# COS_BUCKET_NAME=your_cos_bucket_name

# Tencent Cloud COS app ID
# COS_APP_ID=your_cos_app_id

# Tencent Cloud COS path prefix for file storage
# COS_PATH_PREFIX=your_cos_path_prefix

# COS_ENABLE_OLD_DOMAIN=true enables the old domain format, default true
COS_ENABLE_OLD_DOMAIN=true

# If using Volcengine TOS as file storage, configure the following
# Volcengine TOS endpoint, e.g. https://tos-cn-beijing.volces.com
# TOS_ENDPOINT=https://tos-cn-beijing.volces.com

# Volcengine TOS region, e.g. cn-beijing
# TOS_REGION=cn-beijing

# Volcengine TOS access key
# TOS_ACCESS_KEY=your_tos_access_key

# Volcengine TOS secret key
# TOS_SECRET_KEY=your_tos_secret_key

# Volcengine TOS bucket name
# TOS_BUCKET_NAME=your_tos_bucket_name

# Volcengine TOS optional path prefix
# TOS_PATH_PREFIX=your_tos_path_prefix

# Volcengine TOS temp bucket name (optional, for auto-expiring temp files)
# TOS_TEMP_BUCKET_NAME=your_tos_temp_bucket_name

# Volcengine TOS temp bucket region (optional, defaults to same as main bucket)
# TOS_TEMP_REGION=your_tos_temp_region

# If using AWS S3 as file storage, configure the following
# AWS S3 endpoint, e.g. https://s3.amazonaws.com
# S3_ENDPOINT=https://s3.amazonaws.com

# AWS S3 region, e.g. us-east-1
# S3_REGION=us-east-1

# AWS S3 access key
# S3_ACCESS_KEY=your_s3_access_key

# AWS S3 secret key
# S3_SECRET_KEY=your_s3_secret_key

# AWS S3 bucket name
# S3_BUCKET_NAME=your_s3_bucket_name

# AWS S3 optional path prefix
# S3_PATH_PREFIX=your_s3_path_prefix

# If using Huawei Cloud OBS as file storage, configure the following
# Huawei Cloud OBS endpoint, e.g. obs.cn-north-4.myhuaweicloud.com
# OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com

# Huawei Cloud OBS region, default cn-north-4
# OBS_REGION=cn-north-4

# Huawei Cloud OBS access key
# OBS_ACCESS_KEY=your_obs_access_key

# Huawei Cloud OBS secret key
# OBS_SECRET_KEY=your_obs_secret_key

# Huawei Cloud OBS bucket name
# OBS_BUCKET_NAME=your_obs_bucket_name

# Huawei Cloud OBS optional path prefix
# OBS_PATH_PREFIX=weknora/


# Huawei Cloud OBS proxy domain (optional, highest priority)
# OBS_PROXY_DOMAIN=https://your-domain.com/obs

# Web proxy for network connections (optional)
# WEB_PROXY=your_web_proxy

# Neo4j enable
# NEO4J_ENABLE=false

# Neo4j address
# NEO4J_URI=neo4j://neo4j:7687

# Neo4j username and password
# NEO4J_USERNAME=neo4j

# Neo4j password
# NEO4J_PASSWORD=password

# ========== File Upload Size Limit ==========
# Unified file size limit (MB), default 50MB.
# Affects: single file upload, docreader gRPC message size, frontend Nginx request body size,
#          and client-side validation in the browser.
#
# This is a deployment-time configuration: all four layers (Go backend / Nginx / docreader / browser bundle)
# read it once at container startup; changing the env at runtime will not take effect.
# All four must be restarted after modification.
# This was previously attempted as a runtime system_settings entry, but Nginx / docreader / browser bundle
# would not reload, resulting in the UI allowing 200MB but Nginx returning 413 at 50MB.
# Hence the UI entry was removed. See internal/utils/filesize.go comments.
# MAX_FILE_SIZE_MB=50

# ========== Agent Skills Sandbox Configuration ==========
# Sandbox mode: docker (default), local, disabled
WEKNORA_SANDBOX_MODE=docker

# Script execution timeout (seconds), default 60
WEKNORA_SANDBOX_TIMEOUT=60


# ========== Agent Configuration ==========
# Agent LLM call default timeout (seconds), default 120
# For complex reasoning, increase this value (e.g. 300 or 600)
# Note: this is the global default. If an individual agent has a separate llm_call_timeout configured in the DB,
# the per-agent config takes precedence.
# WEKNORA_AGENT_LLM_TIMEOUT=300

# MCP tool human-in-the-loop approval timeout (seconds) (optional)
# When an MCP tool is marked as "requires approval", the Agent pauses and waits for user confirmation.
# This controls the maximum wait time; timeout is treated as rejection. Default 600 (10 minutes).
# Also supports Go duration syntax (e.g. 30s / 5m / 1h).
# WEKNORA_AGENT_TOOL_APPROVAL_TIMEOUT=600

# ========== Tenant / RBAC Configuration ==========
# Enable tenant-level RBAC (role-based enforcement via the tenant_members table).
# - true (default): requests without active membership or insufficient role receive 403
# - false: observation mode, logs but does not block — use only during initial rollout for auditing role assignments
# Detailed grayscale migration plan: docs/RBAC说明.md.
# Note: when using Air hot-reload in dev, modifying this variable requires restarting the dev script.
# WEKNORA_TENANT_ENABLE_RBAC=true

# Automatically promote the user with the specified email to SystemAdmin at startup.
# - The user must have already registered; if not, a warning is logged and it retries on next restart
# - Idempotent: already-SystemAdmin users are a no-op on bootstrap
# - PROMOTE only, never DEMOTE: manual revocation via UI is not overridden on restart
# - Suitable for initial bootstrapping in docker-compose / k8s deployments
# WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

# Maximum number of tenants a non-superuser can self-create (as Owner).
# Only Owner role counts — invited Admin/Editor/Viewer roles are not counted.
# Superusers with CanAccessAllTenants are not affected.
#   > 0  : hard limit; returns 429 when exceeded
#   = 0  : uses handler default
#   < 0  : disables limit entirely (not recommended for shared deployments)
# WEKNORA_TENANT_MAX_OWNED_PER_USER=

# APK mirror source (optional)
APK_MIRROR_ARG=mirrors.tencent.com

# If using Milvus as vector store, configure the following
# Milvus address
# MILVUS_ADDRESS=milvus:19530

# Milvus collection name for storing vector data
# MILVUS_COLLECTION=weknora_embeddings

# Milvus vector search metric type. Options: IP (default), COSINE, L2
# Note: changing the metric type requires rebuilding the collection
# MILVUS_METRIC_TYPE=IP

# Milvus username (optional)
# MILVUS_USERNAME=your_milvus_username

# Milvus password (optional)
# MILVUS_PASSWORD=your_milvus_password

# Milvus database name (optional)
# MILVUS_DB_NAME=your_milvus_db_name

# Docreader address
DOCREADER_ADDR=docreader:50051

# Docreader transport protocol
DOCREADER_TRANSPORT=grpc

# gRPC TLS configuration (optional)
# GRPC_TLS_ENABLED=false
# GRPC_TLS_CERT=/path/to/server.crt           # server: required; client: for mTLS
# GRPC_TLS_KEY=/path/to/server.key            # same as above
# GRPC_TLS_CA=/path/to/ca.crt                 # client: to verify server cert; server: CA for mTLS client certs
# GRPC_TLS_SERVER_NAME=                       # optional; set to cert hostname when DOCREADER_ADDR uses IP or differs from CN
# GRPC_MTLS_REQUIRE_CLIENT_CERT=false         # server: true forces client certificate (mTLS)

# gRPC auth token (optional; client and server must use the same value)
# Note: when GRPC_AUTH_TOKEN is enabled, it is strongly recommended to also enable TLS,
# otherwise the token is transmitted in plaintext over the network with every RPC.
# When GRPC_TLS_ENABLED=true, the client will refuse to send the token over an insecure connection.
# GRPC_AUTH_TOKEN=your-secret-token-at-least-16-bytes

# Maximum pages for DOCX parsing in Docreader, default 0 (unlimited)
# Set to a positive number (e.g. 500) to limit parsing overhead for very large Word documents
# DOCREADER_DOCX_MAX_PAGES=0

# Docreader heavy parser concurrency control. Limits resource usage when importing many PDFs/OCRs.
# Set to 0 to disable rate limiting; default 1 is suitable for single-machine or GPU-limited deployments.
# DOCREADER_MARKITDOWN_MAX_WORKERS=1
# DOCREADER_PDF_RENDER_MAX_WORKERS=1
# DOCREADER_PDF_RENDER_DPI=200
# DOCREADER_PDF_JPEG_QUALITY=90

# If using Weaviate as vector store, configure the following
# Note: inside containers use service:port (not localhost or host-mapped ports)
# Weaviate HTTP address (Docker: weaviate:8080; host access: localhost:9035)
# WEAVIATE_HOST=weaviate:8080

# Weaviate gRPC address (Docker: weaviate:50051; host access: localhost:50052)
# WEAVIATE_GRPC_ADDRESS=weaviate:50051

# Image URL keep-list (optional, comma-separated)
# Images from these domains are still downloaded and analyzed (OCR/subtitles), but the original URL
# is preserved in markdown instead of being replaced with a provider:// object storage URL.
# Suitable for internal stable services (e.g. self-hosted MinerU).
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# Weaviate scheme
# WEAVIATE_SCHEME=http

# Enable authentication (if Weaviate has APIKey/OIDC auth enabled, set this to true and configure WEAVIATE_API_KEY)
# WEAVIATE_AUTH_ENABLED=false

# API key (optional)
# WEAVIATE_API_KEY=your_secret_key

# Weaviate collection name (optional)
#WEAVIATE_COLLECTION=your_weaviate_db_name

# If using Apache Doris 4.1+ as vector store, configure the following
# Doris FE MySQL protocol address (host:port). Inside containers, use service name doris-fe:9030.
# DORIS_ADDR=doris-fe:9030

# Doris FE HTTP port for Stream Load partial updates.
# DORIS_HTTP_PORT=8030

# Doris target database name (CREATE DATABASE weknora;)
# DORIS_DATABASE=weknora

# Doris username (default root)
# DORIS_USERNAME=root

# Doris password (default empty)
# DORIS_PASSWORD=

# Doris table prefix, physical tables are <prefix>_<dim>
# DORIS_TABLE_PREFIX=weknora_embeddings

# Doris compatibility mode: auto (probe server), legacy (cosine_distance), or inner_product_duplicate (inner_product); NOT interchangeable after tables are created.
# DORIS_COMPAT_MODE=

# Supadata API Key (required for YouTube transcript & metadata import)
# Get one at https://supadata.ai
# SUPADATA_API_KEY=

# Tavily Search API Key (optional, enables Tavily web search provider)
# TAVILY_API_KEY=tvly-your_tavily_api_key

# ----- OIDC Auth -----
# To enable OIDC login, set to true and fill in the fields below
# OIDC_AUTH_ENABLE=false

# (Optional) OIDC discovery endpoint configuration
# OIDC_AUTH_ISSUER_URL=http://127.0.0.1:5556/dex
# OIDC_AUTH_DISCOVERY_URL=http://127.0.0.1:5556/dex/.well-known/openid-configuration

# OIDC_AUTH_PROVIDER_DISPLAY_NAME=OIDC
# OIDC_AUTH_CLIENT_ID=client_id_for_oidc_client
# OIDC_AUTH_CLIENT_SECRET=secret_for_oidc_client

# (Optional) OIDC endpoint config. If OIDC_AUTH_DISCOVERY_URL is set above, these can be left empty.
# OIDC_AUTH_AUTHORIZATION_ENDPOINT=http://127.0.0.1:5556/dex/auth
# OIDC_AUTH_TOKEN_ENDPOINT=http://127.0.0.1:5556/dex/token
# OIDC_AUTH_USER_INFO_ENDPOINT=http://127.0.0.1:5556/dex/userinfo

# OIDC_AUTH_SCOPES="openid profile email"

# OIDC user info mapping for extracting user data
# OIDC_USER_INFO_MAPPING_USER_NAME=name
# OIDC_USER_INFO_MAPPING_EMAIL=email

# Document processing task timeout. Large files may need more than Asynq's default 30m.
# WEKNORA_DOCUMENT_PROCESS_TIMEOUT=2h

# --- Async pipeline tuning (optional) -----------------------------------------
# Worker pool size for the asynq server. Default 16 — raise it on machines
# that handle many concurrent uploads (default Go runtime.NumCPU() under-
# provisions for the I/O-bound document pipeline).
# WEKNORA_ASYNQ_CONCURRENCY=16

# Read/write timeout (in milliseconds) the asynq client uses against Redis.
# Default 500ms (writes scale to 1000ms). Bump if you see "i/o timeout"
# errors during heavy multimodal counter DECRs or large batch uploads.
# WEKNORA_REDIS_OP_TIMEOUT_MS=500

# Maximum wall time for a single DocReader call. Caps a hung docreader
# (network partition, OCR runaway) so it cannot pin a worker for hours.
# Default 30m. Must be shorter than WEKNORA_DOCUMENT_PROCESS_TIMEOUT.
# WEKNORA_DOCREADER_CALL_TIMEOUT=30m

# Background sweep that recovers knowledge stuck in "processing" past
# DocumentProcessTimeout + 10m. Set to "false" to opt out (not recommended).
# WEKNORA_HOUSEKEEPING_ENABLED=true
